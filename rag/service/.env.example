# Fill in and copy this file to `.env` (gitignored).
#
# No ANTHROPIC_API_KEY here -- the backend owns it (backend/.env) and sends it
# per-request on the X-Anthropic-Api-Key header, so the key lives in one place.

# Which Claude model answers chatbot questions.
CLAUDE_MODEL=claude-sonnet-5

# Elasticsearch connection -- defaults match local-dev/docker-compose.yml.
ELASTIC_END_POINT=http://127.0.0.1:9200
ELASTIC_USERNAME=
ELASTIC_PASSWORD=

# How many chunks to retrieve per question.
RAG_TOP_K=5

# Minimum kNN cosine similarity for a chunk to count as a real match (see
# eval/golden_set.jsonl for how this was calibrated). Hits below this are dropped
# before the search_study_material tool result ever reaches Claude, so off-topic
# questions get told "no match" instead of answering from a weak/irrelevant chunk.
RAG_MIN_SCORE=0.75

# Shared secret Spring Boot sends on every call (mirrors judge/api's
# FLASK_X_API_KEY / FLASK_X_CLIENT_ID pattern). Must match backend/.env's
# RAG_X_API_KEY / RAG_X_CLIENT_ID. Leave both blank to disable auth locally.
RAG_X_API_KEY=
RAG_X_CLIENT_ID=

# How many history turns (question+answer pairs count as 2) to forward to Claude as
# conversation context. Independent of the backend's own cap (RagChatbotService).
RAG_MAX_HISTORY_TURNS=6

# Hard cap on the search_study_material tool-use loop per request. The last iteration
# is forced to answer with tool_choice="none" instead of searching again, so a model
# that won't stop searching still returns a grounded answer rather than hanging.
RAG_MAX_TOOL_ITERATIONS=4
